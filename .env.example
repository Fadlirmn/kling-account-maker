# =============================================================
# KLING ACCOUNT MAKER - .env = KREDENSIAL SAJA
# =============================================================
# cp .env.example .env lalu isi. JANGAN commit .env.
# Dibaca oleh docker compose (env_file) DAN backend (load_dotenv dari root repo / ENV_FILE).
#
# Semua konfigurasi NON-rahasia ada di backend/config.json (ikut repo; override lokal:
# backend/config.local.json): site, scheduler, email/OTP, proxy cooldown, browser, default
# worker/batch/jadwal, seed dummy. Port & nama app ada di docker-compose.yml.
# Setting runtime diubah dari dashboard Settings (tabel settings).
# =============================================================


# ---------- Database ----------
# Kosong = SQLite (backend/data/kling_accounts.db; Docker: /data/db/kling_accounts.db)
# PostgreSQL di host, dari container: host.docker.internal (deploy/setup-postgres.sh)
DATABASE_URL=


# ---------- Login dashboard ----------
# Admin cadangan (selalu bisa login). User lain dikelola di Settings > User. Buat/ubah: bash deploy/init-user.sh <user> <password>
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=YOUR_PASSWORD_HERE
# Kunci tanda tangan cookie session, min 32 karakter acak (init-user.sh mengisi otomatis)
AUTH_SECRET=YOUR_RANDOM_SECRET_HERE
# Password awal user dashboard yang dibuat seed_dummy.py (config.json seed.users). Kosong = pakai DASHBOARD_PASSWORD
DASHBOARD_USER_DEFAULT_PASSWORD=


# ---------- Akun yang dibuat ----------
# WAJIB. SATU password untuk semua akun: min 8 karakter, wajib ada huruf kecil, huruf besar,
# angka, dan simbol (divalidasi saat start). Tidak ada default.
KLING_DEFAULT_PASSWORD=


# ---------- Email / OTP (endpoint privat & secret) ----------
# kurmamail: Kurma Mail (email-custom) — URL publik + API key (Admin > API Keys / EMAIL_SERVICE_API_KEY)
KURMAMAIL_URL=
KURMAMAIL_API_KEY=
# webhook: Cloudflare Email Routing -> Worker (URL privat)
CLOUDFLARE_WORKER_URL=
# local_tempmail: Go TempMail self-hosted
TEMPMAIL_API_URL=
TEMPMAIL_SECRET=


# ---------- Proxy (berisi user:pass) ----------
# Format fleksibel: user:pass@host:port | http://user:pass@host:port | host:port:user:pass | host:port (csv)
# Alternatif: satu proxy per baris di backend/data/proxy.txt
PROXY_LIST=
# Croxy rotating: cr-USERNAME:PASSWORD@proxy.croxy.com:PORT -> session ID baru per akun
CROXY_BASE_PROXY=
