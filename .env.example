# =============================================================
# KLING ACCOUNT MAKER - .env = KREDENSIAL + variabel deploy saja
# =============================================================
# cp .env.example .env lalu isi. JANGAN commit .env.
# Dibaca oleh docker compose DAN backend (load_dotenv dari root repo / ENV_FILE).
#
# Konfigurasi aplikasi NON-rahasia (provider email, prefix, OTP, browser, default
# worker/batch/jadwal) ada di backend/config.json (ikut repo; override lokal:
# backend/config.local.json). Setting runtime diubah dari dashboard Settings (tabel settings).
# Env var dengan nama yang sama tetap bisa menimpa config.json (untuk Docker/CI).
# =============================================================


# ---------- [1] Database (kredensial) ----------
# Kosong = SQLite (backend/data/kling_accounts.db; Docker: /data/db/kling_accounts.db)
# PostgreSQL di host, dari container: host.docker.internal (deploy/setup-postgres.sh)
DATABASE_URL=


# ---------- [2] Dashboard (kredensial + port) ----------
# Admin cadangan (selalu bisa login). User lain dikelola di Settings > User. Buat/ubah: bash deploy/init-user.sh <user> <password>
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=YOUR_PASSWORD_HERE
# Kunci tanda tangan cookie session, min 32 karakter acak (init-user.sh mengisi otomatis)
AUTH_SECRET=YOUR_RANDOM_SECRET_HERE
NEXT_PUBLIC_APP_NAME=Kling Account Maker
# Port di host (hanya 127.0.0.1; ekspos via cloudflared / reverse proxy)
DASHBOARD_PORT=3201
API_PORT=8010
# URL backend dilihat dari server Next.js - hanya untuk `npm run dev` di luar Docker
API_BASE_URL=http://localhost:8000


# ---------- [3] Target site (kredensial) ----------
# WAJIB. SATU password untuk semua akun yang dibuat: min 8 karakter, wajib ada huruf kecil, huruf besar,
# angka, dan simbol (divalidasi saat start). Tidak ada default.
KLING_DEFAULT_PASSWORD=


# ---------- [4] Email / OTP (kredensial & endpoint privat) ----------
# webhook: Cloudflare Email Routing -> Worker (URL privat)
CLOUDFLARE_WORKER_URL=
# local_tempmail: Go TempMail self-hosted
TEMPMAIL_API_URL=
TEMPMAIL_SECRET=


# ---------- [5] Proxy (berisi user:pass) ----------
# Format fleksibel: user:pass@host:port | http://user:pass@host:port | host:port:user:pass | host:port (csv)
# Alternatif: satu proxy per baris di backend/data/proxy.txt
PROXY_LIST=
# Croxy rotating: cr-USERNAME:PASSWORD@proxy.croxy.com:PORT -> session ID baru per akun
CROXY_BASE_PROXY=


# ---------- [6] Override opsional (biasanya kosong; lihat backend/config.json) ----------
# ENABLE_SCHEDULER=false        # matikan semua job terjadwal tanpa ubah config.json
# EMAIL_PROVIDER=mailtm         # timpa email.provider
# CONFIG_FILE=/app/config.json  # lokasi config.json lain
# LOG_DIR= / EXPORT_DIR=        # path runtime di luar Docker (Docker sudah set /data/*)
